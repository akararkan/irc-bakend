# IRC Islamic Seed Data — 35 Users (Kurdish Sorani + Arabic)
# Runner: JetBrains HTTP Client / IntelliJ `.http`
# Prerequisites:
# - Backend running at {{baseUrl}}
# - PostgreSQL, Cassandra, Redis, and RabbitMQ available per application config
# - Run the requests from top to bottom in one session so captured IDs/tokens are available
#
# All generated users use a run-specific username/email suffix to avoid duplicate registration errors.
# Content: Kurdish (Sorani) + Arabic. Topics: charity, Gaza humanitarian relief, Kurdistan
# politics, regional politics, education, health, Quran studies, Islamic history, Islamic
# finance, technology, environment, Kurdish culture, women, youth. 35 users, 3-6 posts each,
# 35 reels per user, 35 Q&A threads with answers/accepts, 35 published research papers.
#
# Source basis used in the content:
# - Haji Idrees Surchi Charity Foundation: https://idreescharity.org/ku/
# - Bextewery: https://bextewery.org/
# - Bextewery Gaza: https://bextewery-gaza.org/
# - Haji Karwan YouTube: https://www.youtube.com/channel/UC3lxasjlhE4oRgJAKtKl8_w
# - UNICEF Gaza emergency page: https://www.unicef.org/emergencies/children-gaza-need-lifesaving-support
# - WHO oPt emergency page: https://www.who.int/emergencies/situations/conflict-in-Israel-and-oPt
# - OCHA oPt: https://www.ochaopt.org/

@baseUrl = http://localhost:8080
@runId = {{$timestamp}}
@password = TestData!2026

@idreesImage = https://idreescharity.org/wp-content/uploads/2025/05/slider-1-2-1.jpeg
@idreesLogo = https://idreescharity.org/wp-content/uploads/2024/01/hiscf-logo.png
@karwanImage = https://bextewery.org/wp-content/uploads/2023/04/332939215_724150239326817_1679479344299882085_n.jpg
@bexteweryGazaImage = https://bextewery-gaza.org/storage/blogs/1745916516.jpg
@bexteweryWaterImage = https://bextewery-gaza.org/storage/blogs/1745913798.jpg
@bexteweryWaterImage2 = https://bextewery-gaza.org/storage/blogs/1745913555.jpg
@karwanVideo = https://www.youtube.com/watch?v=RDo64Gej1Nk
@karwanVideoThumb = https://i.ytimg.com/vi/RDo64Gej1Nk/hqdefault.jpg



### 0001. Register test account 01 — حاجی ئیدریس سورچی
# @name reg01
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "fname": "حاجی ئیدریس",
  "lname": "سورچی",
  "username": "u01_idrees_{{runId}}",
  "email": "u01.idrees.{{runId}}@example.com",
  "password": "{{password}}"
}

> {%
    client.test("reg01 returns 201", function () {
        client.assert(response.status === 201, "Expected 201");
    });
    client.global.set("tok01", response.body.accessToken);
    client.global.set("uid01", response.body.user.id);
%}


