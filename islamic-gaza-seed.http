Content-Type: application/json

{
  "postType": "TEXT",
  "visibility": "PUBLIC",
  "textContent": "تێبینییەک بۆ کۆمەڵگا: پاراستنی کەرامەتی سوودمەند لە خزمەتکردنی ئەودا پێش هەموو شتێک دێت. ئەگەر سوودبەخش بوو، لەگەڵ کەسێکی تر هاوبەشی بکەن. #خێرخوازی #سەدەقە #کەفالەت",
  "locationName": "هەولێر، هەرێمی کوردستان"
}

> {%
    client.test("post01_1 returns 200", function () {
        client.assert(response.status === 200, "Expected 200");
    });
