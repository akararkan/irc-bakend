# ════════════════════════════════════════════════════════════════════════════
#  IRC PLATFORM — PRODUCTION ENVIRONMENT VARIABLES
#
#  Copy to a Railway service's "Variables" tab (or to .env for local prod runs).
#  NEVER commit a filled-in .env to git — only .env.example.
# ════════════════════════════════════════════════════════════════════════════

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Postgres (Railway "Postgres" plugin auto-fills these) ─────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=__REPLACE_ME__
# Optional pool tuning:
DB_POOL_MAX=10
DB_POOL_MIN=2
# Optional Hibernate DDL mode — `update` (default) or `validate`/`none` once
# you have explicit migrations.
JPA_DDL_AUTO=update

# ── Redis (Railway "Redis" plugin) ────────────────────────────────────────────
# Easiest: a single connection URL.
SPRING_DATA_REDIS_URL=redis://default:__PASSWORD__@YOUR_HOST:6379
# OR set the discrete vars:
# SPRING_DATA_REDIS_HOST=YOUR_HOST
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=__REPLACE_ME__
REDIS_SSL_ENABLED=false

# ── RabbitMQ (Railway "RabbitMQ" plugin) ──────────────────────────────────────
SPRING_RABBITMQ_HOST=YOUR_HOST
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=__REPLACE_ME__
SPRING_RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false

# ── Authentication ────────────────────────────────────────────────────────────
# Base64-encoded ≥256-bit secret. Generate one with:
#   openssl rand -base64 64
APP_JWT_SECRET=__REPLACE_ME__
# Access token TTL — default 24 hours.
APP_JWT_ACCESS_MS=86400000
# Refresh token TTL — default 90 days. Rotates on every /refresh call, so an
# active user stays logged in indefinitely; only true idleness signs them out.
APP_JWT_REFRESH_MS=7776000000
APP_JWT_ISSUER=irc-platform

# Random 32+ char string, used to sign email-verification links.
IRC_VERIFICATION_SECRET=__REPLACE_ME__

# ── CORS — comma-separated, no trailing slashes ──────────────────────────────
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
# For Gmail use an App Password (2FA must be on).
MAIL_PASSWORD=__REPLACE_ME__
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=IRC Platform
MAIL_ENABLED=true
MAIL_THROTTLE_MINUTES=60

# ── Cloudflare R2 / S3-compatible storage ────────────────────────────────────
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=__REPLACE_ME__
R2_SECRET_KEY=__REPLACE_ME__
R2_BUCKET_NAME=irc
R2_PUBLIC_URL=https://pub-<account>.r2.dev
R2_REGION=auto

# ── Branding / share links ───────────────────────────────────────────────────
IRC_BASE_URL=https://api.example.com
DOI_PREFIX=10.12345

# ── Upload size + server tuning (optional) ───────────────────────────────────
MAX_UPLOAD_SIZE=500MB
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_THREADS=10
