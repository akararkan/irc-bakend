# ════════════════════════════════════════════════════════════════════════════
#  Environment variables for production (Railway).
#
#  Copy these into the Railway service's "Variables" tab and replace every
#  __REPLACE_ME__ with a real value. Local dev does NOT need this file —
#  application.yaml ships sensible localhost defaults.
# ════════════════════════════════════════════════════════════════════════════

# ── Postgres (Railway "Postgres" plugin populates these via "Reference") ────
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=__REPLACE_ME__

# ── Redis (Railway "Redis" plugin) ──────────────────────────────────────────
SPRING_DATA_REDIS_URL=redis://default:__PASSWORD__@YOUR_HOST:6379

# ── RabbitMQ (Railway "RabbitMQ" plugin) ────────────────────────────────────
SPRING_RABBITMQ_HOST=YOUR_HOST
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=__REPLACE_ME__

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 64
APP_JWT_SECRET=__REPLACE_ME__
# Generate with:  openssl rand -hex 24
IRC_VERIFICATION_SECRET=__REPLACE_ME__

# ── Crypto peppers / keys — REQUIRED, no defaults in application.yaml ───────
# Generate each with:  openssl rand -hex 32
# OTP_PEPPER and CONTACT_PEPPER HMAC the OTP codes and phone numbers before
# they are stored; TWOFA_AES_KEY encrypts the TOTP secret at rest.
# ⚠ Set once and NEVER rotate on a database that already has data — every
#   stored hash / encrypted secret was produced with the old value.
OTP_PEPPER=__REPLACE_ME__
CONTACT_PEPPER=__REPLACE_ME__
TWOFA_AES_KEY=__REPLACE_ME__

# ── Public URLs ─────────────────────────────────────────────────────────────
# FRONTEND_URL is where share links and email CTAs send users (the user-facing
# app). IRC_BASE_URL is this backend's own public URL (used as the canonical
# share host — /p/{token}, /r/{token}, /q/{id}).
FRONTEND_URL=https://irc-frontend-517u.vercel.app
IRC_BASE_URL=https://irc-bakend-production.up.railway.app

# ── CORS — comma-separated, no trailing slashes ─────────────────────────────
CORS_ORIGINS=https://irc-frontend-517u.vercel.app

# ── Mail ────────────────────────────────────────────────────────────────────
# On Railway / Heroku / Render / Fly / GCP outbound SMTP is BLOCKED. Use the
# Resend HTTPS API instead — set MAIL_PROVIDER=resend + RESEND_API_KEY below.
# For local dev, leave MAIL_PROVIDER=smtp and supply Gmail credentials.
MAIL_PROVIDER=resend
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=IRC Platform
RESEND_API_KEY=__REPLACE_ME__

# Optional reply-to address (for both transports). If unset, replies go to MAIL_FROM.
# MAIL_REPLY_TO=hello@yourdomain.com

# Only needed when MAIL_PROVIDER=smtp:
# MAIL_USERNAME=no-reply@example.com
# MAIL_PASSWORD=__GMAIL_APP_PASSWORD__

# ── Cloudflare R2 storage ───────────────────────────────────────────────────
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=__REPLACE_ME__
R2_SECRET_KEY=__REPLACE_ME__
R2_BUCKET_NAME=irc
R2_PUBLIC_URL=https://pub-<account>.r2.dev

# (IRC_BASE_URL and FRONTEND_URL are set above under "Public URLs".)

# ── Optional log tuning for prod (defaults are fine to omit) ────────────────
# LOG_LEVEL_APP=INFO
# JPA_SHOW_SQL=false
