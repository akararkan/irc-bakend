PATCH {{baseUrl}}/api/v1/users/me/profile
Authorization: Bearer {{u35Token}}
Content-Type: application/json

{
  "displayName": "مامۆستا هەژار قەرەداغی",
  "profileBio": "ئەکاونتی تاقیکردنەوەیی بۆ مامۆستا هەژار قەرەداغی. پسپۆڕی: هاوکاری خێزان و سەدەقەی خۆماڵی. خێرخوازیی ئیسلامی کاتێک بەهێز دەبێت کە شایستەیی، ڕوونی و پاراستنی کەرامەتی سوودمەند پێکەوە ببات. کۆکردنەوەی سەدەقە بەبێ ڕاپۆرتی ڕوون تەنها دڵنیایی کورتخایەن دروست دەکات، نەک متمانەی درێژخایەن.",
  "selfDescriber": "هاوکاری خێزان و سەدەقەی خۆماڵی",
  "location": "قەرەداغ",
  "academicTitle": "هاوکاری خێزان و سەدەقەی خۆماڵی",
  "institutionName": "تاقیگەی تاقیکردنەوەی کۆمەڵگای ئیسلامی",
  "websiteUrl": "https://idreescharity.org/ku/",
  "isForHire": false,
