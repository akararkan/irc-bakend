# IRC Islamic Community 35-User Seed Data
# Runner: JetBrains HTTP Client / IntelliJ `.http`
# Creates 35 users, profiles, follows, 1-2 posts/user (varies per user), 35 reels, 10 QNA threads total, 5 researches total, comments, reactions, saves, and shares.
# Each of the 35 users has either a QNA thread or a research (never both) — mirrors a real community where only some members post long-form content.
# Content is Kurdish Sorani and Arabic. Reels are one per user to stay under the backend social-write rate limiter.

@baseUrl = http://localhost:8080
@runId = {{$timestamp}}
@password = TestData!2026

### 001. Register user — دەزگای خێرخوازی حاجی ئیدریس سورچی
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "fname": "حاجی ئیدریس",
  "lname": "سورچی",
  "username": "u01_islamic_{{runId}}",
  "email": "u01.islamic.{{runId}}@example.com",
  "password": "{{password}}"
}

> {%
    client.assert(response.status === 201, "Expected 201");
    client.assert(!!response.body.user.id, "Expected registered user id");
    client.global.set("u01Token", response.body.accessToken);
    client.global.set("u01Id", response.body.user.id);
%}


