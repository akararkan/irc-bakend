### 401.1 Post — دەزگای خێرخوازی حاجی ئیدریس سورچی
POST {{baseUrl}}/api/v1/posts
Authorization: Bearer {{u01Token}}
Content-Type: application/json

{
  "postType": "EMBEDDED",
  "visibility": "PUBLIC",
  "textContent": "دەزگای خێرخوازی حاجی ئیدریس سورچی: دوای چەند ساڵ کارکردن لە خێرخوازی و پەرەپێدانی کۆمەڵگا لە هەولێر، فێربووم کە گۆڕانکاریی ئارام لەوپەڕی چالاکی خێرا جێگیرتر و بەردەوامترە. خێرخوازیی ئیسلامی کاتێک بەهێز دەبێت کە شایستەیی، ڕوونی و پاراستنی کەرامەتی سوودمەند پێکەوە ببات. کۆکردنەوەی سەدەقە بەبێ ڕاپۆرتی ڕوون تەنها دڵنیایی کورتخایەن دروست دەکات، نەک متمانەی درێژخایەن.",
  "locationName": "هەولێر",
  "mediaUrls": [
    "https://idreescharity.org/wp-content/uploads/2025/05/slider-1-2-1.jpeg"
  ],
  "mediaTypes": [
    "IMAGE"
  ]
}

> {%
    client.assert(response.status === 200, "Expected 200");
    client.assert(!!response.body.id, "Expected post id");
    client.assert(!!response.body.authorId, "Expected post authorId");
    client.global.set("u01Post1", response.body.id);
%}


